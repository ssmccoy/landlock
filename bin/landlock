#!/usr/bin/env zsh
# Configure landrun using trusted shell-expanded configuration files.
emulate -R zsh
setopt nullglob interactivecomments

usage() {
    print -r -- "Usage: landlock [-hps] [-c CONFIG] [-r DIR] [-w DIR] [-x DIR] command [args ...]"
}

fail() {
    print -ru2 -- "landlock: $*"
    exit 1
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
LANDLOCK_CONFIG=${LANDLOCK_CONFIG:-$XDG_CONFIG_HOME/landlock}
config=""
print_only=false
shell_mode=false
extras=()

while getopts ":hc:r:w:x:ps" opt; do
    case $opt in
        h) usage; exit 0 ;;
        p) print_only=true ;;
        s) shell_mode=true ;;
        c) config=$OPTARG ;;
        r) extras+=(--ro "$OPTARG") ;;
        w) extras+=(--rw "$OPTARG") ;;
        x) extras+=(--rox "$OPTARG") ;;
        :) fail "Option -$OPTARG requires an argument" ;;
        \?) fail "Invalid option: -$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

if (( $# == 0 )); then
    usage >&2
    exit 1
fi

if $shell_mode; then
    [[ -n $SHELL ]] || fail "SHELL is unset or empty"
fi

config=${config:-$LANDLOCK_CONFIG/${1:t}.cfg}
[[ -f $config && -r $config ]] || fail "Cannot read configuration: $config"

params=()
directories=()
files=("$config")
typeset -A seen

for directory in "${path[@]}"; do
    params+=(--rox "${directory:-.}")
done

# Read included files after the current file, once per resolved filename.
while (( ${#files} )); do
    file=$files[1]
    files[1]=()
    file=${file:A}

    [[ -n ${seen[$file]} ]] && continue
    [[ -f $file && -r $file ]] || fail "Cannot read configuration: $file"
    seen[$file]=1

    while IFS= read -r line || [[ -n $line ]]; do
        words=()

        # Configurations are trusted zsh input; retain quoting and expansion.
        eval "words=( $line
        )" || fail "Invalid configuration in $file"

        (( ${#words} )) || continue
        directive=$words[1]
        words[1]=()

        case $directive in
            include)
                (( ${#words} == 1 )) || fail "include requires one filename in $file"
                files+=("$LANDLOCK_CONFIG/$words[1]")
                ;;
            dir)
                (( ${#words} )) && directories+=("${words[@]}")
                ;;
            best-effort|unrestricted-filesystem|unrestricted-network|ldd|add-exec)
                (( ${#words} == 0 )) || fail "$directive takes no arguments in $file"
                params+=("--$directive")
                ;;
            *)
                for word in "${words[@]}"; do
                    params+=("--$directive" "$word")
                done
                ;;
        esac
    done < "$file"
done

params+=("${extras[@]}")
command_args=("$@")

if $shell_mode; then
    command_args=("$SHELL")
fi

if $print_only; then
    print -r -- landrun "${(@q)params}" -- "${(@q)command_args}"
    exit 0
fi

if (( ${#directories} )); then
    mkdir -p -- "${directories[@]}" || fail "Cannot create configured directories"
fi

exec landrun "${params[@]}" -- "${command_args[@]}"
